<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <mujoco_inputs>

    <!-- The contents of `raw_inputs` will be copied and pasted directly into the MJCF -->
    <raw_inputs>
      <option integrator="implicitfast"/>
      <compiler texturedir="$(find sim)/worlds/assets"/>

      <default>
        <default class="visual">
          <geom group="2" type="mesh" contype="0" conaffinity="0"/>
        </default>
        <default class="collision">
          <geom group="3" type="mesh"/>
        </default>
      </default>

      <actuator>
        <velocity name="FL_Wheel_Rotate" joint="FL_Wheel_Rotate" />
        <velocity name="FR_Wheel_Rotate" joint="FR_Wheel_Rotate" />
        <velocity name="LA_Extend" joint="LA_Extend" />
        <velocity name="Excavation_Rotate" joint="Excavation_Rotate" />
      </actuator>
      <equality>
        <joint joint1="ML_Wheel_Rotate" joint2="FL_Wheel_Rotate"/>
        <joint joint1="BL_Wheel_Rotate" joint2="FL_Wheel_Rotate"/>
        <joint joint1="TL_Wheel_Rotate" joint2="FL_Wheel_Rotate"/>

        <joint joint1="MR_Wheel_Rotate" joint2="FR_Wheel_Rotate"/>
        <joint joint1="BR_Wheel_Rotate" joint2="FR_Wheel_Rotate"/>
        <joint joint1="TR_Wheel_Rotate" joint2="FR_Wheel_Rotate"/>
      </equality>
      <!-- <extension>
        <plugin plugin="mujoco.plugin.lidar">
          <instance name="lidar">
            <config key="resolution" value="360 1"/>
            <config key="azimuth_range" value="-3.14159 3.14159"/>
            <config key="elevation_range" value="0.0"/>
            <config key="max_range" value="10.0"/>
            <config key="min_range" value="0.1"/>
          </instance>
        </plugin>
      </extension> -->

      <!-- <sensor>
        <plugin name="lidar" instance="lidar" objtype="site" objname="lidar_link_optical"/>
      </sensor> -->
    </raw_inputs>

    <!-- Specific inputs that require processing from the conversion script-->
    <processed_inputs>
      <!-- Specifying decompose_mesh will set the `decompose` flag when using obj2mjcf -->
      <!-- <decompose_mesh mesh_name="forearm" threshold="0.05"/> -->

      <!-- The camera with the specified values will be added at the specified site name. -->
      <!-- The position and quaterinion will be filled in by the converter -->

      <!-- <camera site="camera_link_optical" name="camera" fovy="58" mode="fixed" resolution="640 480"/> -->

      <!-- The element with the type and name as listed below will be modified with the remaining attributes -->
      <!-- If the attribute already existed, it will be overwritten -->
      <!-- Note that the type and name elements are required -->

      <!-- <modify_element type="joint" name="DL_Rotate" damping="0.1" armature="0.1"/> -->

      <!-- Per-part visual colors (OBJ meshes ignore URDF colors) -->
      <modify_element type="geom" mesh="BLA"          class="visual" rgba="0.667 0.557 0.322 1"/>
      <modify_element type="geom" mesh="BL_Wheel"     class="visual" rgba="0.565 0.667 0.882 1"/>
      <modify_element type="geom" mesh="BR_Wheel"     class="visual" rgba="0.698 0.682 0.427 1"/>
      <modify_element type="geom" mesh="Chassis"      class="visual" rgba="0.859 0.584 0.561 1"/>
      <modify_element type="geom" mesh="DL_Wheel"     class="visual" rgba="0.361 0.635 0.522 1"/>
      <modify_element type="geom" mesh="DR_Wheel"     class="visual" rgba="0.718 0.616 0.839 1"/>
      <modify_element type="geom" mesh="Excavation"   class="visual" rgba="0.286 0.631 0.667 1"/>
      <modify_element type="geom" mesh="FL_Wheel"     class="visual" rgba="0.824 0.584 0.718 1"/>
      <modify_element type="geom" mesh="FR_Wheel"     class="visual" rgba="0.400 0.737 0.694 1"/>
      <modify_element type="geom" mesh="Hopper"       class="visual" rgba="0.537 0.725 0.537 1"/>
      <modify_element type="geom" mesh="Hopper_Door"  class="visual" rgba="0.549 0.541 0.769 1"/>
      <modify_element type="geom" mesh="Hopper_Latch" class="visual" rgba="0.817 0.627 0.443 1"/>
      <modify_element type="geom" mesh="LA"           class="visual" rgba="0.420 0.714 0.827 1"/>
      <modify_element type="geom" mesh="ML_Wheel"     class="visual" rgba="0.525 0.608 0.380 1"/>
      <modify_element type="geom" mesh="MR_Wheel"     class="visual" rgba="0.675 0.502 0.686 1"/>
      <modify_element type="geom" mesh="TLA"          class="visual" rgba="0.745 0.486 0.545 1"/>
      <modify_element type="geom" mesh="TL_Wheel"     class="visual" rgba="0.745 0.506 0.400 1"/>
      <modify_element type="geom" mesh="TR_Wheel"     class="visual" rgba="0.392 0.592 0.765 1"/>
    </processed_inputs>
  </mujoco_inputs>
</robot>